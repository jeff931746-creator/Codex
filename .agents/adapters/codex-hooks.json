{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-reference-permission.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-workspace-write-targets.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex block-private-memory-write.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-context-pressure.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|exec_command|functions.exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-commit-message.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex warn-dangerous.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-flow-gates.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-thin-runtime-pointers.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-task-flow-state.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-gdd-workflow.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-content-governance-gates.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex stop-status.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-neat-freak.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-validation.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-impl-checklist.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -X utf8 .agents/hooks/run-hook.py --runtime codex check-context-pressure.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
