flowchart TD
    A["用户提出设计文档任务"] --> B["gdd-write Skill"]

    B --> C["读取 GDD 写作标准"]
    B --> D["读取 多Agent设计文档工作流.md"]

    D --> E["工作流判定当前阶段"]

    E --> F["按阶段读取对应判断原则"]
    F --> F1["目标拆解原则 / 质询原则 / 循环推演原则 / 落地细化原则 / 写作原则 / 验收原则"]

    F --> G["加载对应 role-card"]
    G --> H["调用对应 agent"]

    H --> I["agent 输出材料"]
    I --> J["主策 agent 决策"]

    J --> K{"是否进入下一阶段？"}

    K -- "是" --> E
    K -- "否：需补资料 / 打回 / 降级 / 停止" --> L["防死循环检查"]
    L --> M{"有新输入且未超打回次数？"}

    M -- "是" --> E
    M -- "否" --> N["主策裁决：补资料 / 降级低保真 / 停止方向"]

    J --> O["写作完成后进入交付验收"]
    O --> P["交付验收 agent"]
    P --> Q{"验收结果"}

    Q -- "低保真通过" --> R["交付低保真草稿 + 正式化阻断项"]
    Q -- "正式通过" --> S["交付正式 GDD"]
    Q -- "打回" --> L
